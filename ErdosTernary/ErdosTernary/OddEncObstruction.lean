-- Unified theorem: for d ∈ [25, 70], the carry machine dies by position d+4.
-- Split into three ranges based on the modulus parameter q used:
--   d ∈ [25,59]: M=64, M1=128
--   d = 60:      M=128, M1=256
--   d ∈ [61,70]: M=64, M1=128

theorem odd_enc_obstruction_all (d : ℕ) (hd : 25 ≤ d) (hle : d ≤ 70) :
    (if d = 60 then machineDead 60 64 128 256 else machineDead d (d + 4) 64 128) = true := by
  interval_cases d <;> native_decide

