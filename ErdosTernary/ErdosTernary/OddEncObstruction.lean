partial def carryStep (M M1 targetParity : ℕ) (S : ℕ) (p_j vBits : ℕ) : ℕ :=
  let rec loopCi (ci : ℕ) (acc : ℕ) : ℕ :=
    if ci >= M then acc
    else
      let acc' := if S.testBit ci then
        let rec loopVi (vi : ℕ) (acc2 : ℕ) : ℕ :=
          if vi >= M1 then acc2
          else
            let acc2' := if vBits.testBit vi && (p_j + vi + ci) % 2 == targetParity then
              acc2 ||| (1 <<< ((p_j + vi + ci) / 2 % M))
            else acc2
            loopVi (vi + 1) acc2'
        loopVi 0 acc
      else acc
      loopCi (ci + 1) acc'
  loopCi 0 0

partial def carryRun (d M M1 : ℕ) (j : ℕ) : ℕ :=
  let tbl := tableData d
  let rec loop (pos : ℕ) (acc : ℕ) : ℕ :=
    if pos >= j then acc
    else
      let entry := tbl.getD pos (0, 0)
      let targetParity := if pos % 2 == 0 then 1 else 0
      loop (pos + 1) (carryStep M M1 targetParity acc entry.1 entry.2)
  loop 0 1

def machineDead (d j M M1 : ℕ) : Bool := carryRun d M M1 j == 0

