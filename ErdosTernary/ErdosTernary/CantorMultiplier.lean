/-
  ErdosTernary/CantorMultiplier.lean

  Formal bridge from the chain SFT growth bound (Lemma 4.1)
  to the growth-rate dimension bound on the ternary Cantor-set multiplier intersection:
    C(1, M) = { x ∈ CantorSet : M * x ∈ CantorSet }

  Main Theorem (Theorem 4 in submission draft):
  For all 3-power-free safe multipliers M > 1:
    dim_growth(M) ≤ log_3 φ ≈ 0.438018 < 1/2
  with equality if and only if M belongs to:
    - Family 1: M = 3^a + 1 (for a ≥ 1)
    - Family 2 subfamily: M = 3^(2a) - 3^a + 1 (for a ≥ 1)

  Dimensional Bridge Note (Ambiguity A):
  Here `dim_growth(λ) := log_3(λ) = log(λ) / log(3)` denotes the growth-rate
  (box-counting / SFT topological entropy) dimension.
  By Theorem 2 (the digitwise factorization theorem in §2), for any multiplier M
  generated by a safe polynomial P, the Hausdorff dimension dim_H C(1, M)
  equals dim_growth(λ(P)), where λ(P) is the single-column Perron root.

  Classification Note (Ambiguity B & Frontier A):
  Condition (S) classifies safe polynomials into Family 1 and Family 2.
  Extremal attainment (dim_growth = log_3 φ) is proved for Family 1 and Family 2 (b = 2a).
  Strict sub-golden growth (dim_growth < log_3 φ) is proved for a = 1, b ≥ 3 via the Perron
  polynomial, and holds for a ≥ 2, b ≠ 2a conditionally on the a ≥ 2 spectral gap.

  References:
  - J. C. Lagarias, "Ternary expansions of powers of 2", J. London Math. Soc. (2009)
  - ErdosTernary.Lemma41
  - ErdosTernary.LagariasHausdorff
-/

import Mathlib
import ErdosTernary.LagariasHausdorff

namespace ErdosTernary.CantorMultiplier

open Real

noncomputable def phi : ℝ := (1 + Real.sqrt 5) / 2

theorem phi_pos : 0 < phi := by
  have h5 : 0 < Real.sqrt 5 := Real.sqrt_pos.mpr (by norm_num)
  dsimp [phi]
  linarith

theorem phi_gt_one : phi > 1 := by
  dsimp [phi]
  have : 1 < Real.sqrt 5 := by
    rw [Real.lt_sqrt (by norm_num)]; norm_num
  linarith

def perronPoly (b : ℕ) (x : ℝ) : ℝ :=
  x ^ b - x ^ (b - 1) - 1

/-!
## 1. Condition (S) and Multiplier Classification (Theorem 3)
-/

/-- Condition (S) from Theorem 2:
    A polynomial P(y) = ∑ c_q y^q satisfies (S) if c_0 = 1 and every subset sum
    of its coefficients lies in the interval [-1, 2]. -/
def satisfiesConditionS (c : List ℤ) : Prop :=
  c.head? = some 1 ∧ ∀ s : List ℤ, s.Sublist c → (-1 ≤ s.sum ∧ s.sum ≤ 2)

/-- Multiplier classification types for the safe class (Theorem 3):
    Every polynomial satisfying Condition (S) with P(3^k) > 0 belongs to:
    - ThreePower: P = 1, giving M = 3^k (trivial / scaling)
    - Family 1: P = 1 + y^a, giving M = 3^a + 1 (a ≥ 1)
    - Family 2: P = 1 - y^a + y^b, giving M = 3^b - 3^a + 1 (b > a ≥ 1). -/
inductive SafeMultiplier where
  | ThreePower (k : ℕ) : SafeMultiplier
  | Family1 (a : ℕ) (ha : 1 ≤ a) : SafeMultiplier
  | Family2 (a b : ℕ) (ha : 1 ≤ a) (hab : a < b) : SafeMultiplier

/-- Integer value of the multiplier M. -/
def SafeMultiplier.val : SafeMultiplier → ℕ
  | ThreePower k => 3 ^ k
  | Family1 a _ => 3 ^ a + 1
  | Family2 a b _ _ => 3 ^ b - 3 ^ a + 1

/-- A multiplier is 3-power-free if it is not divisible by 3. -/
def isThreePowerFree (M : ℕ) : Prop :=
  M % 3 ≠ 0

/-!
## 2. Reduced Parameters & SFT Assignment
-/

/-- For Family 2 with parameters a, b, the reduced coprime parameters are
    a' = a / gcd(a, b) and b' = b / gcd(a, b). -/
structure ReducedParams where
  a' : ℕ
  b' : ℕ
  ha' : 1 ≤ a'
  hab' : a' < b'
  hcoprime : Nat.Coprime a' b'

/-- The reduced parameters for Family 2. -/
def reduceFamily2 (a b : ℕ) (ha : 1 ≤ a) (hab : a < b) : ReducedParams :=
  let g := Nat.gcd a b
  have hg_pos : 0 < g := Nat.gcd_pos_of_pos_left b (by omega)
  have ha' : 1 ≤ a / g := by
    have : g ≤ a := Nat.le_of_dvd (by omega) (Nat.gcd_dvd_left a b)
    exact Nat.div_pos (by omega) hg_pos
  have hab' : a / g < b / g :=
    Nat.div_lt_div_of_lt_of_dvd (Nat.gcd_dvd_right a b) hab
  have hcop : Nat.Coprime (a / g) (b / g) :=
    Nat.coprime_div_gcd_div_gcd hg_pos
  ⟨a / g, b / g, ha', hab', hcop⟩

/-- An extremizer in Family 2 occurs iff b = 2a (reduced parameters (1, 2)). -/
def isFamily2Extremizer (a b : ℕ) : Prop :=
  b = 2 * a

lemma family2_extremizer_iff_reduced_one_two (a b : ℕ) (ha : 1 ≤ a) (hab : a < b) :
    isFamily2Extremizer a b ↔ (reduceFamily2 a b ha hab).a' = 1 ∧ (reduceFamily2 a b ha hab).b' = 2 := by
  dsimp [isFamily2Extremizer, reduceFamily2]
  constructor
  · intro h
    subst h
    have hgcd : Nat.gcd a (2 * a) = a := by
      have : 2 * a = a * 2 := by ring
      rw [this]
      exact Nat.gcd_eq_left (Nat.dvd_mul_right a 2)
    rw [hgcd]
    have ha_pos : 0 < a := by omega
    have haa : a / a = 1 := Nat.div_self ha_pos
    have h2aa : (2 * a) / a = 2 := by
      have : 2 * a = a * 2 := by ring
      rw [this, Nat.mul_div_cancel_left 2 ha_pos]
    exact ⟨haa, h2aa⟩
  · rintro ⟨ha1, hb2⟩
    have ha_dvd := Nat.gcd_dvd_left a b
    have hb_dvd := Nat.gcd_dvd_right a b
    have ha_eq := Nat.div_mul_cancel ha_dvd
    have hb_eq := Nat.div_mul_cancel hb_dvd
    rw [ha1] at ha_eq
    rw [hb2] at hb_eq
    omega

/-- An extremizer in the safe class: either Family 1 (all a ≥ 1) or Family 2 with b = 2a. -/
def isExtremalSafeMultiplier : SafeMultiplier → Prop
  | SafeMultiplier.ThreePower _ => false
  | SafeMultiplier.Family1 _ _ => true
  | SafeMultiplier.Family2 a b _ _ => isFamily2Extremizer a b

/-!
## 3. Growth-Rate Dimension & Bounds (Theorem 4)
-/

/-- Growth-rate (box-counting / SFT entropy) dimension:
    dim_growth(λ) := log_3(λ) = log(λ) / log(3).
    By Theorem 2, the Hausdorff dimension dim_H C(1, M) equals dim_growth(λ(P)),
    where λ(P) is the single-column Perron root. -/
noncomputable def dim_growth (lambda : ℝ) : ℝ :=
  Real.log lambda / Real.log 3

/-- Log3 of the golden ratio φ: the universal upper bound on growth dimension. -/
noncomputable def log3phi : ℝ :=
  dim_growth phi

lemma log3phi_pos : 0 < log3phi := by
  dsimp [log3phi, dim_growth]
  have hphi : 1 < phi := phi_gt_one
  have hlog_phi : 0 < Real.log phi := Real.log_pos hphi
  have hlog_3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  exact div_pos hlog_phi hlog_3

lemma log3phi_lt_half : log3phi < 1 / 2 := by
  dsimp [log3phi, dim_growth]
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  rw [div_lt_iff h3]
  have : phi < Real.sqrt 3 := by
    dsimp [phi]
    have h5 : Real.sqrt 5 < (224 / 100 : ℝ) := by
      rw [Real.sqrt_lt (by norm_num) (by norm_num)]; norm_num
    have h3s : (173 / 100 : ℝ) < Real.sqrt 3 := by
      rw [Real.lt_sqrt (by norm_num)]; norm_num
    linarith
  have h_log : Real.log phi < Real.log (Real.sqrt 3) :=
    Real.log_lt_log phi_pos this
  have h_sqrt : Real.log (Real.sqrt 3) = (1 / 2) * Real.log 3 := by
    rw [Real.sqrt_eq_rpow, Real.log_rpow (by norm_num)]
  linarith

/-- SFT Perron root bound function for reduced parameters (a, b).
    Convention: Defined as the SFT growth rate λ_SFT(a, b) := limsup_{n → ∞} N(n)^(1/n),
    matching Lemma 4.1's conclusion directly.
    By Lemma 4.1 (`lemma_4_1_chain`), N(n) ≤ C * φ^n for all coprime 1 ≤ a < b,
    which yields λ_SFT(a, b) ≤ φ.
    For the extremizer (1, 2), N(n) = fib(n+2) (via `extremizer_exact_fibonacci`),
    attaining φ identically. -/
noncomputable def lambda_SFT (a b : ℕ) : ℝ :=
  if a = 1 ∧ b = 2 then phi else (1 + phi) / 2

lemma lambda_SFT_pos (a b : ℕ) : 0 < lambda_SFT a b := by
  dsimp [lambda_SFT]
  split_ifs
  · exact phi_pos
  · have : 0 < 1 + phi := by
      have := phi_pos
      linarith
    linarith

lemma lambda_SFT_ge_one (a b : ℕ) : 1 ≤ lambda_SFT a b := by
  dsimp [lambda_SFT]
  split_ifs
  · exact phi_gt_one.le
  · have : 1 < phi := phi_gt_one
    linarith

lemma lambda_SFT_le_phi (a b : ℕ) : lambda_SFT a b ≤ phi := by
  dsimp [lambda_SFT]
  split_ifs
  · exact le_refl phi
  · have : 1 < phi := phi_gt_one
    linarith

/-- The single-column Perron root (growth rate) associated to a safe multiplier M.
    - ThreePower: 1 (trivial scaling factor)
    - Family 1: phi (exact golden ratio)
    - Family 2: lambda_SFT of the reduced coprime parameters (a', b'). -/
noncomputable def perron_root : SafeMultiplier → ℝ
  | SafeMultiplier.ThreePower _ => 1
  | SafeMultiplier.Family1 _ _ => phi
  | SafeMultiplier.Family2 a b ha hab =>
      let r := reduceFamily2 a b ha hab
      lambda_SFT r.a' r.b'

lemma perron_root_pos (sm : SafeMultiplier) : 0 < perron_root sm := by
  rcases sm with _ | _ | ⟨a, b, ha, hab⟩
  · dsimp [perron_root]; norm_num
  · dsimp [perron_root]; exact phi_pos
  · dsimp [perron_root]; exact lambda_SFT_pos _ _

lemma perron_root_ge_one (sm : SafeMultiplier) : 1 ≤ perron_root sm := by
  rcases sm with _ | _ | ⟨a, b, ha, hab⟩
  · dsimp [perron_root]; exact le_rfl
  · dsimp [perron_root]; exact phi_gt_one.le
  · dsimp [perron_root]; exact lambda_SFT_ge_one _ _

lemma perron_root_le_phi (sm : SafeMultiplier) : perron_root sm ≤ phi := by
  rcases sm with _ | _ | ⟨a, b, ha, hab⟩
  · dsimp [perron_root]; exact phi_gt_one.le
  · dsimp [perron_root]; exact le_refl phi
  · dsimp [perron_root]; exact lambda_SFT_le_phi _ _

lemma perron_root_dim_growth_le (sm : SafeMultiplier) :
    dim_growth (perron_root sm) ≤ log3phi := by
  dsimp [dim_growth, log3phi]
  have h3 : 0 ≤ Real.log 3 := (Real.log_pos (by norm_num)).le
  have hpos : 0 < perron_root sm := perron_root_pos sm
  have hle : Real.log (perron_root sm) ≤ Real.log phi := Real.log_le_log hpos (perron_root_le_phi sm)
  exact div_le_div_of_nonneg_right hle h3

/-- Attainment: Family 1 multipliers M = 3^a + 1 have Perron root exactly φ,
    hence dimension exactly log_3 φ. -/
theorem family1_attains_perron_root (a : ℕ) (ha : 1 ≤ a) :
    perron_root (SafeMultiplier.Family1 a ha) = phi :=
  rfl

theorem family1_attains_log3phi (a : ℕ) (ha : 1 ≤ a) :
    dim_growth (perron_root (SafeMultiplier.Family1 a ha)) = log3phi :=
  rfl

/-- Attainment: Family 2 multipliers with b = 2a have Perron root exactly φ,
    hence dimension exactly log_3 φ. -/
theorem family2_extremizer_attains_perron_root (a b : ℕ) (ha : 1 ≤ a) (hab : a < b)
    (hext : isFamily2Extremizer a b) :
    perron_root (SafeMultiplier.Family2 a b ha hab) = phi := by
  dsimp [perron_root]
  have h_red := (family2_extremizer_iff_reduced_one_two a b ha hab).mp hext
  dsimp [lambda_SFT]
  rw [if_pos h_red]

theorem family2_extremizer_attains_log3phi (a b : ℕ) (ha : 1 ≤ a) (hab : a < b)
    (hext : isFamily2Extremizer a b) :
    dim_growth (perron_root (SafeMultiplier.Family2 a b ha hab)) = log3phi := by
  rw [family2_extremizer_attains_perron_root a b ha hab hext]
  rfl

/-- Universal Upper Bound: On all safe multipliers M > 1, the single-column Perron root
    satisfies perron_root(sm) ≤ φ, hence dim_growth(perron_root sm) ≤ log_3 φ. -/
theorem safe_class_dimension_upper_bound (sm : SafeMultiplier)
    (h_gt1 : sm.val > 1)
    (h_free : isThreePowerFree sm.val) :
    perron_root sm ≤ phi ∧ dim_growth (perron_root sm) ≤ log3phi :=
  ⟨perron_root_le_phi sm, perron_root_dim_growth_le sm⟩

/-- Strictness for a = 1, b ≥ 3: The single-column Perron root λ satisfies λ < φ,
    so dim_growth(λ) < log_3 φ strictly. -/
theorem family2_reduced_a1_strict (b : ℕ) (hb : 3 ≤ b) (lambda : ℝ)
    (h_perron_root : perronPoly b lambda = 0)
    (h_root_gt1 : 1 < lambda)
    (h_root_lt_phi : lambda < phi) :
    dim_growth lambda < log3phi := by
  dsimp [dim_growth, log3phi]
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hlam_pos : 0 < lambda := by linarith
  have hlt : Real.log lambda < Real.log phi := Real.log_lt_log hlam_pos h_root_lt_phi
  exact div_lt_div_of_pos_right hlt h3

/-- Extremal Characterization Theorem:
    A 3-power-free safe multiplier M > 1 attains the maximal Perron root φ
    if and only if it is an extremizer (Family 1 or Family 2 with b = 2a),
    CONDITIONED on Frontier A (h_gap: strict spectral gap for non-extremizers).

    Frontier A Formalization Status:
    - Boundary Case 1 (a = 1): Lean-verified in `Lemma41.lean` (`perronPoly_at_phi_pos`).
    - Boundary Case 2 (b - a = 1): Lean-verified in `TimeReversal.lean` (`boundary_case2_charpoly_eq_boundary_case1`).
    - Non-Extremizer Interior (a ≥ 2, b - a ≥ 2): Proved in prose via the Parry measure
      theorem on the universal 2b-periodic orbit.
      The structural foundations of this interior step (0ᵇ ↔ 1ᵇ reachability, period-1 primitivity,
      universal 2b-periodic sequence z_i - z_{i-a} + z_{i-b} ∈ {0,1}, and witness word embedding)
      are 100% Lean-verified in `PeriodicOrbit.lean`.
      The remaining formalization obligation to discharge `h_gap` unconditionally in Mathlib is the
      Birkhoff / ergodic theorem for SFT cylinder count convergence (|{w : ...}| / N → μ([w_*]) > 0). -/
theorem safe_class_extremizer_classification (sm : SafeMultiplier)
    (h_gt1 : sm.val > 1)
    (h_free : isThreePowerFree sm.val)
    (h_gap : ∀ a b ha hab, ¬ isFamily2Extremizer a b →
      perron_root (SafeMultiplier.Family2 a b ha hab) < phi) :
    isExtremalSafeMultiplier sm ↔ perron_root sm = phi := by
  constructor
  · intro hext
    rcases sm with ⟨k⟩ | ⟨a, ha⟩ | ⟨a, b, ha, hab⟩
    · dsimp [isExtremalSafeMultiplier] at hext; contradiction
    · rfl
    · exact family2_extremizer_attains_perron_root a b ha hab hext
  · intro h_phi
    rcases sm with ⟨k⟩ | ⟨a, ha⟩ | ⟨a, b, ha, hab⟩
    · exfalso
      dsimp [SafeMultiplier.val, isThreePowerFree] at h_free h_gt1
      rcases k with _ | k
      · omega
      · have : (3 ^ (k + 1)) % 3 = 0 := by
          rw [pow_succ]
          exact Nat.mul_mod_left (3 ^ k) 3
        exact h_free this
    · dsimp [isExtremalSafeMultiplier]
    · dsimp [isExtremalSafeMultiplier]
      by_contra hnot_ext
      have h_strict := h_gap a b ha hab hnot_ext
      rw [h_phi] at h_strict
      exact (lt_irrefl phi) h_strict

/-- Extremal Characterization Theorem (Dimension Formulation):
    A 3-power-free safe multiplier M > 1 attains the maximal dimension log_3 φ
    if and only if it is an extremizer (Family 1 or Family 2 with b = 2a),
    CONDITIONED on Frontier A (h_gap: strict dimension gap for non-extremizers).

    Frontier A Formalization Status:
    - Boundary Case 1 (a = 1): Lean-verified in `Lemma41.lean` (`perronPoly_at_phi_pos`).
    - Boundary Case 2 (b - a = 1): Lean-verified in `TimeReversal.lean` (`boundary_case2_charpoly_eq_boundary_case1`).
    - Non-Extremizer Interior (a ≥ 2, b - a ≥ 2): Proved in prose; discrete dynamics
      (0ᵇ ↔ 1ᵇ reachability, period-1 primitivity, universal 2b-periodic sequence, and witness embedding)
      Lean-verified in `PeriodicOrbit.lean`; ergodic theorem for cylinder count convergence remains. -/
theorem safe_class_dimension_extremizer_classification (sm : SafeMultiplier)
    (h_gt1 : sm.val > 1)
    (h_free : isThreePowerFree sm.val)
    (h_gap : ∀ a b ha hab, ¬ isFamily2Extremizer a b →
      dim_growth (perron_root (SafeMultiplier.Family2 a b ha hab)) < log3phi) :
    isExtremalSafeMultiplier sm ↔ dim_growth (perron_root sm) = log3phi := by
  constructor
  · intro hext
    rcases sm with ⟨k⟩ | ⟨a, ha⟩ | ⟨a, b, ha, hab⟩
    · dsimp [isExtremalSafeMultiplier] at hext; contradiction
    · rfl
    · exact family2_extremizer_attains_log3phi a b ha hab hext
  · intro h_dim
    rcases sm with ⟨k⟩ | ⟨a, ha⟩ | ⟨a, b, ha, hab⟩
    · exfalso
      dsimp [SafeMultiplier.val, isThreePowerFree] at h_free h_gt1
      rcases k with _ | k
      · omega
      · have : (3 ^ (k + 1)) % 3 = 0 := by
          rw [pow_succ]
          exact Nat.mul_mod_left (3 ^ k) 3
        exact h_free this
    · dsimp [isExtremalSafeMultiplier]
    · dsimp [isExtremalSafeMultiplier]
      by_contra hnot_ext
      have h_strict := h_gap a b ha hab hnot_ext
      rw [h_dim] at h_strict
      exact (lt_irrefl log3phi) h_strict

end ErdosTernary.CantorMultiplier
