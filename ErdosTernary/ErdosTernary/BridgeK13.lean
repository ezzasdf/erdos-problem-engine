-- Bridge check: for each r in NK_13 \ {0,2,8}, 2^r has digit 2 in first 50 ternary digits.
-- Uses 2^r % 3^50 directly (not pow2Mod) so the kernel can type-check.
set_option maxHeartbeats 800000 in
theorem bridge_K13_pow2mod :
    NK_13_candidates.all fun r =>
      r == 0 || r == 2 || r == 8 ||
      hasDigit2UpTo (2 ^ r % 3 ^ 50) 50 = true := by native_decide

-- Direct bridge check using computeNKFast
set_option maxHeartbeats 800000 in
theorem checkBridgeCantorPow2_13 : checkBridgeCantorPow2 13 = true := by native_decide
