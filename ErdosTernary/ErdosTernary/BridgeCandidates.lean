/-
  Bridge Theorem: pow2Mod-based verification for K=13..16
  
  N_K candidate lists generated externally (Python via recurrence x0=1, x_{n+1}=2x_n mod 3^K).
  Lean verifies: for each r in N_K \ {0,2,8}, hasDigit2UpTo (2^r) 50.
  Uses pow2Mod to avoid huge 2^r intermediates.
-/
import Mathlib.Tactic
import ErdosTernary.BridgeCompute

open ErdosTernary.BridgeCompute

namespace ErdosTernary.BridgeCandidates

/-- Check bridge: all non-special candidates have digit 2 in ternary positions 0..49. -/
def checkBridgeCandidates (candidates : Array Nat) (K : Nat) : Bool :=
  candidates.all fun r =>
    r == 0 || r == 2 || r == 8 ||
    hasDigit2UpTo (pow2Mod r (3 ^ 50)) 50

