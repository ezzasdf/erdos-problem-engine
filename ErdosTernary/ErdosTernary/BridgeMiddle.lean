/-- Check if val has digit 2 in ternary positions lo..hi-1. -/
def hasDigit2InRange (val lo hi : Nat) : Bool :=
  (List.range (hi - lo)).any fun i => (val / 3 ^ (lo + i)) % 3 == 2

/-- Check middle-digit bridge for a hardcoded N_K list. -/
def checkMiddleBridgeList (nK : List Nat) (K : Nat) : Bool :=
  let mod50 := 3 ^ 50
  nK.all fun r =>
    r == 0 || r == 2 || r == 8 ||
    hasDigit2InRange (2 ^ r % mod50) K 50

/-- Key lemma: if hasDigit2InRange (2^r mod 3^M) lo hi = true with hi <= M,
    then not (memCantorNat (2^r)). -/
theorem modM_hasDigit2_not_cantor (r lo hi M : Nat) (hhi : hi <= M)
    (h : hasDigit2InRange (2 ^ r % 3 ^ M) lo hi = true) :
    ¬(memCantorNat (2 ^ r)) := by
  unfold hasDigit2InRange at h
  rw [List.any_eq_true] at h
  obtain ⟨i, hi_range, heq⟩ := h
  rw [List.mem_range] at hi_range
  simp only [beq_iff_eq] at heq
  intro hc
  have hi_lo : lo + i >= lo := Nat.le_add_right lo i
  have hi_bound : lo + i < hi := by omega
  have hi_M : lo + i < M := Nat.lt_of_lt_of_le hi_bound hhi
  have hmod_eq : (2 ^ r % 3 ^ M) / 3 ^ (lo + i) % 3 = (2 ^ r) / 3 ^ (lo + i) % 3 := by
    have hMk : 1 <= M - (lo + i) := by omega
    have hpow_mul : 3 ^ (lo + i) * 3 ^ (M - (lo + i)) = 3 ^ M := by
      rw [← Nat.pow_add, Nat.add_sub_cancel' (by omega : lo + i <= M)]
    have h1 : (2 ^ r % 3 ^ M) / 3 ^ (lo + i) = (2 ^ r) / 3 ^ (lo + i) % 3 ^ (M - (lo + i)) := by
      have := Nat.mod_mul_right_div_self (2 ^ r) (3 ^ (lo + i)) (3 ^ (M - (lo + i)))
      rwa [hpow_mul] at this
    have h2 : (2 ^ r / 3 ^ (lo + i) % 3 ^ (M - (lo + i))) % 3 = (2 ^ r) / 3 ^ (lo + i) % 3 :=
      Nat.mod_mod_of_dvd _ (Nat.pow_dvd_pow 3 hMk)
    rw [h1, h2]
  rw [hmod_eq] at heq
  exact hc (lo + i) heq

